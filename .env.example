# OKX API 凭据
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here
OKX_SIMULATED=1
OKX_PROXY=
OKX_API_HOST=www.okx.com
# 注意：如需使用第三方镜像网关，必须自行核实域名归属与 TLS 证书，
# 切勿将真实 API 密钥发往任何非官方或无法验证的域名。

# GitHub 配置
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_repo_name

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000
# 服务认证密钥（必填）：所有 /api/ 与 /ws/ 端点默认拒绝，
# 请求需带 X-API-Key 头且值等于此处配置；未设置时交易类端点返回 503
API_AUTH_KEY=please_change_me_to_a_long_random_string
